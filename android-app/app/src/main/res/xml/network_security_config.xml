<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed at the OS level so you can reach your own engine on home Wi-Fi
     (http://192.168.x.x:8000). The app itself (UrlPolicy) refuses plain http:// to any public host,
     and all broker / Delta / AI endpoints are hard-coded https://. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
