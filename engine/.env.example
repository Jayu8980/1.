# Copy to .env (never commit it). On the VM prefer a secrets manager / docker secrets.
ENGINE_MODE=PAPER
ENGINE_ALLOW_LIVE=false
ENGINE_LIVE_CONFIRM_PHRASE=I UNDERSTAND THIS USES REAL MONEY

# Angel One SmartAPI (https://smartapi.angelbroking.com)
ENGINE_SMARTAPI_API_KEY=
ENGINE_SMARTAPI_CLIENT_CODE=
ENGINE_SMARTAPI_MPIN=
ENGINE_SMARTAPI_TOTP_SECRET=
ENGINE_SMARTAPI_LOCAL_IP=10.0.0.4
ENGINE_SMARTAPI_MAC=02:00:00:00:00:01

# Which broker the LIVE path uses: angelone | zerodha | upstox | dhan | fyers
# (can be switched from the app while in PAPER). Only fill in the brokers you use.
ENGINE_LIVE_BROKER=angelone
ENGINE_PUBLIC_BASE_URL=https://your-vm.example.com   # OAuth redirect base
ENGINE_TOKEN_STORE_PATH=/data/broker_tokens.json

# Zerodha Kite Connect — redirect URL: <PUBLIC_BASE_URL>/api/v1/brokers/zerodha/callback
ENGINE_ZERODHA_API_KEY=
ENGINE_ZERODHA_API_SECRET=
# Upstox — redirect URL: <PUBLIC_BASE_URL>/api/v1/brokers/upstox/callback
ENGINE_UPSTOX_CLIENT_ID=
ENGINE_UPSTOX_CLIENT_SECRET=
# Dhan — access token from web.dhan.co > DhanHQ Trading APIs
ENGINE_DHAN_CLIENT_ID=
ENGINE_DHAN_ACCESS_TOKEN=
# Fyers — redirect URL: <PUBLIC_BASE_URL>/api/v1/brokers/fyers/callback
ENGINE_FYERS_APP_ID=
ENGINE_FYERS_SECRET=

# Compliance
ENGINE_STATIC_IP=
ENGINE_IP_CHECK_TTL_S=30
ENGINE_ORDERS_PER_SEC=8
ENGINE_DAILY_LOGIN_TIME_IST=08:30
ENGINE_DAILY_LOGOUT_TIME_IST=23:45
ENGINE_AUDIT_LOG_PATH=/data/audit.jsonl

# Paper broker
ENGINE_PAPER_STARTING_CAPITAL=1000000
ENGINE_PAPER_SLIPPAGE_BPS=5

# API
ENGINE_JWT_SECRET=            # >= 32 random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ENGINE_APP_USER=
ENGINE_APP_PASSWORD_HASH=     # python -m app.api.security
ENGINE_DEVICE_KEYS_PATH=/data/device_keys.json
