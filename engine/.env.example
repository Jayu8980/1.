# Copy to .env. Prefer `python -m tradelens secrets` to keep secrets encrypted in secrets.enc.
ENGINE_DOMAIN=engine.example.com
TRADELENS_API_TOKEN=generate-with-python-m-tradelens-token
TRADELENS_MODE=paper            # paper | live
TRADELENS_CAPITAL=1000000
TRADELENS_TARGET_VOL=0.13
# Live Indian orders go through your static-IP relay:
TRADELENS_RELAY_URL=https://relay.example.com
TRADELENS_RELAY_TOKEN=
TRADELENS_BROKER=kite
TRADELENS_BROKER_SESSION=
# Delta Exchange India
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_TESTNET=true
DELTA_PRODUCTION_UNLOCKED=false
