# Copy to .env (never commit it). On the VM prefer a secrets manager / docker secrets.
ENGINE_MODE=PAPER
ENGINE_ALLOW_LIVE=false
ENGINE_LIVE_CONFIRM_PHRASE=I UNDERSTAND THIS USES REAL MONEY

# Angel One SmartAPI (https://smartapi.angelbroking.com)
ENGINE_SMARTAPI_API_KEY=
ENGINE_SMARTAPI_CLIENT_CODE=
ENGINE_SMARTAPI_MPIN=
ENGINE_SMARTAPI_TOTP_SECRET=
ENGINE_SMARTAPI_LOCAL_IP=10.0.0.4
ENGINE_SMARTAPI_MAC=02:00:00:00:00:01

# Compliance
ENGINE_STATIC_IP=
ENGINE_IP_CHECK_TTL_S=30
ENGINE_ORDERS_PER_SEC=8
ENGINE_DAILY_LOGIN_TIME_IST=08:30
ENGINE_DAILY_LOGOUT_TIME_IST=23:45
ENGINE_AUDIT_LOG_PATH=/data/audit.jsonl

# Paper broker
ENGINE_PAPER_STARTING_CAPITAL=1000000
ENGINE_PAPER_SLIPPAGE_BPS=5

# API
ENGINE_JWT_SECRET=
