<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext disabled everywhere. Certificate pinning is enforced in OkHttp with the
     pin configured in Settings (so the pin can rotate without a new APK). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
