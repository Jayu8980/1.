# Copy to .env (chmod 600). Never commit .env.
RELAY_DOMAIN=relay.example.com
RELAY_TOKEN=change-me-to-32+-random-characters
# Optional: only accept requests from these source IPs (leave empty for mobile clients)
RELAY_ALLOW_IPS=
RELAY_PUBLIC_IP=203.0.113.10
RELAY_BROKERS=kite,upstox,angel,fyers,dhan
RELAY_MAX_ORDER_VALUE=500000
RELAY_MAX_ORDERS_PER_DAY=50
# Broker-issued algo IDs (SEBI retail algo framework) – one per broker, or a single ALGO_ID
ALGO_ID_KITE=
ALGO_ID_UPSTOX=
ALGO_ID_ANGEL=
ALGO_ID_FYERS=
ALGO_ID_DHAN=
# API keys needed in order headers
KITE_API_KEY=
ANGEL_API_KEY=
FYERS_API_KEY=
DHAN_CLIENT_ID=
