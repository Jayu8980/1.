<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/about"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about" />
        </LinearLayout>

        <!-- 1. input -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pick" />

                <Button
                    android:id="@+id/convert"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent"
                    android:enabled="false"
                    android:text="@string/convert"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/record"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#FFE53935"
                    android:text="@string/record"
                    android:textColor="#FFFFFFFF" />

                <Button
                    android:id="@+id/save_wav"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/save_wav"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/level"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progressTint="#FFE53935"
                android:visibility="gone" />

            <TextView
                android:id="@+id/file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="@string/no_file"
                android:textColor="@color/text_secondary" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 2. player -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tab_falling"
                    style="@style/Tab"
                    android:text="@string/tab_falling" />

                <Button
                    android:id="@+id/tab_roll"
                    style="@style/Tab"
                    android:text="@string/tab_roll" />

                <Button
                    android:id="@+id/tab_sheet"
                    style="@style/Tab"
                    android:text="@string/tab_sheet" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginTop="6dp">

                <com.hft.piano2midi.FallingNotesView
                    android:id="@+id/falling"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <HorizontalScrollView
                    android:id="@+id/roll_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:visibility="gone">

                    <com.hft.piano2midi.PianoRollView
                        android:id="@+id/roll"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent" />
                </HorizontalScrollView>

                <ScrollView
                    android:id="@+id/sheet_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFDADCE3"
                    android:nestedScrollingEnabled="true"
                    android:visibility="gone">

                    <com.hft.piano2midi.SheetView
                        android:id="@+id/sheet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </ScrollView>
            </FrameLayout>

            <com.hft.piano2midi.KeyboardView
                android:id="@+id/keyboard"
                android:layout_width="match_parent"
                android:layout_height="96dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="96dp"
                    android:text="@string/play" />

                <Button
                    android:id="@+id/stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stop" />

                <TextView
                    android:id="@+id/time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="0:00 / 0:00"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/metronome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metronome" />

                <CheckBox
                    android:id="@+id/count_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/count_in" />

                <TextView
                    android:id="@+id/beat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:letterSpacing="0.15"
                    android:textColor="@color/primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/speed_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="128dp"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/speed_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="35"
                    android:progress="15" />

                <Button
                    android:id="@+id/speed_reset"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:text="@string/speed_reset" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/part_melody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#FFFF7043"
                    android:checked="true"
                    android:text="@string/part_melody" />

                <CheckBox
                    android:id="@+id/part_chords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#FF66BB6A"
                    android:checked="true"
                    android:text="@string/part_chords" />

                <CheckBox
                    android:id="@+id/part_bass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#FF42A5F5"
                    android:checked="true"
                    android:text="@string/part_bass" />
            </LinearLayout>

            <TextView
                android:id="@+id/stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- loop & practice -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/loop_title" />

            <CheckBox
                android:id="@+id/loop_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loop_on" />

            <LinearLayout style="@style/Row">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/from_bar" />

                <Button
                    android:id="@+id/loop_a_minus"
                    style="@style/Stepper"
                    android:text="−" />

                <TextView
                    android:id="@+id/loop_a"
                    style="@style/StepperValue" />

                <Button
                    android:id="@+id/loop_a_plus"
                    style="@style/Stepper"
                    android:text="+" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/to_bar" />

                <Button
                    android:id="@+id/loop_b_minus"
                    style="@style/Stepper"
                    android:text="−" />

                <TextView
                    android:id="@+id/loop_b"
                    style="@style/StepperValue" />

                <Button
                    android:id="@+id/loop_b_plus"
                    style="@style/Stepper"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/loop_a_here"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/loop_a_here" />

                <Button
                    android:id="@+id/loop_b_here"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/loop_b_here" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/practice_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/practice_on" />

            <LinearLayout
                android:id="@+id/practice_opts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/practice_start_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <SeekBar
                    android:id="@+id/practice_start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="15"
                    android:progress="7" />

                <LinearLayout style="@style/Row">

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="140dp"
                        android:text="@string/practice_step" />

                    <Spinner
                        android:id="@+id/practice_step"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/practice_countin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/practice_countin" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/practice_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/wait_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wait_on" />

            <LinearLayout
                android:id="@+id/wait_opts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/wait_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wait_mic" />

                <TextView
                    android:id="@+id/wait_midi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wait_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/play_part_row"
                style="@style/Row"
                android:visibility="gone">

                <TextView
                    style="@style/RowLabel"
                    android:layout_width="140dp"
                    android:text="@string/practice_mute" />

                <Spinner
                    android:id="@+id/practice_mute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/wait_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFB26A00"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/loop_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/primary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. instruments -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/instruments" />

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/part_melody"
                    android:textColor="#FFE64A19" />

                <Spinner
                    android:id="@+id/inst_melody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/part_chords"
                    android:textColor="#FF388E3C" />

                <Spinner
                    android:id="@+id/inst_chords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/part_bass"
                    android:textColor="#FF1976D2" />

                <Spinner
                    android:id="@+id/inst_bass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/sf2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/load_sf2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/load_sf2" />

                <Button
                    android:id="@+id/builtin_sf2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/builtin_sf2" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. download -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/download" />

            <Spinner
                android:id="@+id/export_part"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/save_midi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary"
                    android:text="@string/save_midi"
                    android:textColor="#FFFFFFFF" />

                <Button
                    android:id="@+id/save_pdf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary"
                    android:text="@string/save_pdf"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/share_midi"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/share_midi" />

                <Button
                    android:id="@+id/share_pdf"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/share_pdf" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. music analysis -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/music" />

            <TextView
                android:id="@+id/tempo_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/tempo_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="180"
                    android:progress="80" />

                <Button
                    android:id="@+id/tempo_auto"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto" />
            </LinearLayout>

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/time_signature" />

                <Spinner
                    android:id="@+id/time_sig"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/analysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 6. detection -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/settings" />

            <TextView
                android:id="@+id/onset_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <SeekBar
                android:id="@+id/onset_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="95"
                android:progress="50" />

            <TextView
                android:id="@+id/offset_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <SeekBar
                android:id="@+id/offset_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="95"
                android:progress="50" />

            <TextView
                android:id="@+id/frame_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <SeekBar
                android:id="@+id/frame_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="95"
                android:progress="50" />

            <LinearLayout style="@style/Row">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/offset_mode" />

                <Spinner
                    android:id="@+id/offset_mode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
