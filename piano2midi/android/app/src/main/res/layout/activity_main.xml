<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp">

        <!-- ============================== hero ============================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/hero_bg"
            android:elevation="3dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_piano"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp" />

                <ImageButton
                    android:id="@+id/theme_btn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_hero_outline"
                    android:contentDescription="@string/theme"
                    android:src="@drawable/ic_theme"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/about"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_hero_outline"
                    android:contentDescription="@string/about"
                    android:src="@drawable/ic_info"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/subtitle"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/record"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_hero_light"
                    android:drawableStart="@drawable/ic_mic"
                    android:drawableTint="@color/record"
                    android:text="@string/record"
                    android:textColor="@color/record" />

                <Button
                    android:id="@+id/pick"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_hero_outline"
                    android:drawableStart="@drawable/ic_folder"
                    android:drawableTint="#FFFFFFFF"
                    android:text="@string/pick"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:drawableStart="@drawable/ic_music"
                android:drawablePadding="8dp"
                android:drawableTint="#CCFFFFFF"
                android:ellipsize="middle"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="@string/no_file"
                android:textColor="#F2FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/convert"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_hero_light"
                android:enabled="false"
                android:text="@string/convert"
                android:textColor="@color/hero_start" />

            <ProgressBar
                android:id="@+id/level"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_hero"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_hero"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/save_wav"
                style="@style/Btn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/btn_hero_outline"
                android:drawableStart="@drawable/ic_download"
                android:drawableTint="#FFFFFFFF"
                android:text="@string/save_wav"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============================== player ============================== -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/track_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/tab_falling"
                    style="@style/Tab"
                    android:text="@string/tab_falling" />

                <Button
                    android:id="@+id/tab_roll"
                    style="@style/Tab"
                    android:text="@string/tab_roll" />

                <Button
                    android:id="@+id/tab_sheet"
                    style="@style/Tab"
                    android:text="@string/tab_sheet" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/viz_frame"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/viz_bg">

                <com.hft.piano2midi.FallingNotesView
                    android:id="@+id/falling"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <HorizontalScrollView
                    android:id="@+id/roll_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:visibility="gone">

                    <com.hft.piano2midi.PianoRollView
                        android:id="@+id/roll"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent" />
                </HorizontalScrollView>

                <ScrollView
                    android:id="@+id/sheet_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/sheet_bg"
                    android:nestedScrollingEnabled="true"
                    android:padding="6dp"
                    android:visibility="gone">

                    <com.hft.piano2midi.SheetView
                        android:id="@+id/sheet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </ScrollView>
            </FrameLayout>

            <com.hft.piano2midi.KeyboardView
                android:id="@+id/keyboard"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="2dp" />

            <!-- transport -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/play"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/btn_round"
                    android:contentDescription="@string/play"
                    android:elevation="2dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/on_primary" />

                <ImageButton
                    android:id="@+id/stop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_round_tonal"
                    android:contentDescription="@string/stop"
                    android:src="@drawable/ic_stop"
                    android:tint="@color/on_primary_container" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="0:00 / 0:00"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/beat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.2"
                        android:textColor="@color/primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- speed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/speed_label"
                    style="@style/Label"
                    android:drawableStart="@drawable/ic_speed"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/text_secondary"
                    android:minWidth="150dp"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/speed_seek"
                    style="@style/Slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="35"
                    android:progress="15" />

                <Button
                    android:id="@+id/speed_reset"
                    style="@style/Btn.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/speed_reset" />
            </LinearLayout>

            <!-- toggle chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/part_melody"
                        style="@style/Chip"
                        android:backgroundTint="@color/chip_melody"
                        android:checked="true"
                        android:text="@string/part_melody" />

                    <CheckBox
                        android:id="@+id/part_chords"
                        style="@style/Chip"
                        android:backgroundTint="@color/chip_chords"
                        android:checked="true"
                        android:text="@string/part_chords" />

                    <CheckBox
                        android:id="@+id/part_bass"
                        style="@style/Chip"
                        android:backgroundTint="@color/chip_bass"
                        android:checked="true"
                        android:text="@string/part_bass" />

                    <CheckBox
                        android:id="@+id/metronome"
                        style="@style/Chip"
                        android:drawableStart="@drawable/ic_metronome"
                        android:text="@string/metronome" />

                    <CheckBox
                        android:id="@+id/count_in"
                        style="@style/Chip"
                        android:text="@string/count_in" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/stats"
                style="@style/Hint"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- ============================== download ============================== -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="14dp"
                android:drawableTint="@color/primary"
                android:gravity="center_vertical"
                android:text="@string/download" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/export_part"
                    style="@style/Field" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/save_midi"
                    style="@style/Btn.Filled"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_music"
                    android:text="@string/save_midi" />

                <Button
                    android:id="@+id/save_pdf"
                    style="@style/Btn.Filled"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_download"
                    android:text="@string/save_pdf" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/share_midi"
                    style="@style/Btn.Outlined"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_share"
                    android:text="@string/share_midi" />

                <Button
                    android:id="@+id/share_pdf"
                    style="@style/Btn.Outlined"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_share"
                    android:text="@string/share_pdf" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================== loop & practice ============================== -->
        <LinearLayout
            style="@style/Card"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/sec_loop_h"
                style="@style/SectionHeader"
                android:drawableStart="@drawable/ic_repeat"
                android:text="@string/loop_title" />

            <LinearLayout
                android:id="@+id/sec_loop_b"
                style="@style/SectionBody">

                <CheckBox
                    android:id="@+id/loop_on"
                    style="@style/Chip"
                    android:drawableStart="@drawable/ic_repeat"
                    android:text="@string/loop_on" />

                <LinearLayout
                    style="@style/Row"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Label"
                        android:layout_marginEnd="8dp"
                        android:text="@string/from_bar" />

                    <Button
                        android:id="@+id/loop_a_minus"
                        style="@style/Stepper"
                        android:text="−" />

                    <TextView
                        android:id="@+id/loop_a"
                        style="@style/StepperValue" />

                    <Button
                        android:id="@+id/loop_a_plus"
                        style="@style/Stepper"
                        android:text="+" />

                    <TextView
                        style="@style/Label"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/to_bar" />

                    <Button
                        android:id="@+id/loop_b_minus"
                        style="@style/Stepper"
                        android:text="−" />

                    <TextView
                        android:id="@+id/loop_b"
                        style="@style/StepperValue" />

                    <Button
                        android:id="@+id/loop_b_plus"
                        style="@style/Stepper"
                        android:text="+" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/loop_a_here"
                        style="@style/Btn.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="@string/loop_a_here"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/loop_b_here"
                        style="@style/Btn.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/loop_b_here"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/practice_on"
                        style="@style/Chip"
                        android:drawableStart="@drawable/ic_speed"
                        android:text="@string/practice_on" />

                    <CheckBox
                        android:id="@+id/wait_on"
                        style="@style/Chip"
                        android:drawableStart="@drawable/ic_piano"
                        android:text="@string/wait_short" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/practice_opts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/practice_start_label"
                        style="@style/Label" />

                    <SeekBar
                        android:id="@+id/practice_start"
                        style="@style/Slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="15"
                        android:progress="7" />

                    <LinearLayout style="@style/Row">

                        <TextView
                            style="@style/RowLabel"
                            android:layout_width="150dp"
                            android:text="@string/practice_step" />

                        <Spinner
                            android:id="@+id/practice_step"
                            style="@style/Field" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/practice_countin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:buttonTint="@color/primary"
                        android:text="@string/practice_countin" />

                    <TextView
                        style="@style/Hint"
                        android:text="@string/practice_hint" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wait_opts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Label"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/wait_on" />

                    <CheckBox
                        android:id="@+id/wait_mic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:buttonTint="@color/primary"
                        android:text="@string/wait_mic" />

                    <TextView
                        android:id="@+id/wait_midi"
                        style="@style/Hint"
                        android:drawableStart="@drawable/ic_piano"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/text_secondary"
                        android:gravity="center_vertical" />

                    <TextView
                        style="@style/Hint"
                        android:layout_marginTop="4dp"
                        android:text="@string/wait_hint" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/play_part_row"
                    style="@style/Row"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="110dp"
                        android:text="@string/practice_mute" />

                    <Spinner
                        android:id="@+id/practice_mute"
                        style="@style/Field" />
                </LinearLayout>

                <TextView
                    android:id="@+id/wait_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/wait_text" />

                <TextView
                    android:id="@+id/loop_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================== instruments ============================== -->
        <LinearLayout
            style="@style/Card"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/sec_inst_h"
                style="@style/SectionHeader"
                android:drawableStart="@drawable/ic_piano"
                android:text="@string/instruments" />

            <LinearLayout
                android:id="@+id/sec_inst_b"
                style="@style/SectionBody">

                <LinearLayout style="@style/Row">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/part_melody"
                        android:textColor="@color/part_melody_text" />

                    <Spinner
                        android:id="@+id/inst_melody"
                        style="@style/Field" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Row"
                    android:layout_marginTop="8dp">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/part_chords"
                        android:textColor="@color/part_chords_text" />

                    <Spinner
                        android:id="@+id/inst_chords"
                        style="@style/Field" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Row"
                    android:layout_marginTop="8dp">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/part_bass"
                        android:textColor="@color/part_bass_text" />

                    <Spinner
                        android:id="@+id/inst_bass"
                        style="@style/Field" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sf2_name"
                    style="@style/Hint"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/load_sf2"
                        style="@style/Btn.Tonal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_folder"
                        android:text="@string/load_sf2" />

                    <Button
                        android:id="@+id/builtin_sf2"
                        style="@style/Btn.Outlined"
                        android:layout_width="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/builtin_sf2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============================== tempo, key, chords ============================== -->
        <LinearLayout
            style="@style/Card"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/sec_music_h"
                style="@style/SectionHeader"
                android:drawableStart="@drawable/ic_key"
                android:text="@string/music" />

            <LinearLayout
                android:id="@+id/sec_music_b"
                style="@style/SectionBody">

                <TextView
                    android:id="@+id/tempo_label"
                    style="@style/Label"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/tempo_seek"
                        style="@style/Slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="180"
                        android:progress="80" />

                    <Button
                        android:id="@+id/tempo_auto"
                        style="@style/Btn.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minHeight="36dp"
                        android:text="@string/auto"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Row"
                    android:layout_marginTop="8dp">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/time_signature" />

                    <Spinner
                        android:id="@+id/time_sig"
                        style="@style/Field" />
                </LinearLayout>

                <TextView
                    android:id="@+id/analysis"
                    style="@style/Label"
                    android:layout_width="match_parent"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================== note detection ============================== -->
        <LinearLayout
            style="@style/Card"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/sec_detect_h"
                style="@style/SectionHeader"
                android:drawableStart="@drawable/ic_tune"
                android:text="@string/settings" />

            <LinearLayout
                android:id="@+id/sec_detect_b"
                style="@style/SectionBody">

                <TextView
                    android:id="@+id/onset_label"
                    style="@style/Label" />

                <SeekBar
                    android:id="@+id/onset_seek"
                    style="@style/Slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="95"
                    android:progress="50" />

                <TextView
                    android:id="@+id/offset_label"
                    style="@style/Label"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:id="@+id/offset_seek"
                    style="@style/Slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="95"
                    android:progress="50" />

                <TextView
                    android:id="@+id/frame_label"
                    style="@style/Label"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:id="@+id/frame_seek"
                    style="@style/Slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="95"
                    android:progress="50" />

                <LinearLayout
                    style="@style/Row"
                    android:layout_marginTop="8dp">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/offset_mode" />

                    <Spinner
                        android:id="@+id/offset_mode"
                        style="@style/Field" />
                </LinearLayout>

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_hint" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/footer" />
    </LinearLayout>
</ScrollView>
