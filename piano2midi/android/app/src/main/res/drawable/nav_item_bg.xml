<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 navigation: pill indicator behind the selected destination. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="2dp" android:insetBottom="2dp">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/nav_indicator" />
                        <corners android:radius="18dp" />
                    </shape>
                </inset>
            </item>
            <item><color android:color="#00000000" /></item>
        </selector>
    </item>
</ripple>
